# Copy this file to backend/.env and edit the values.
# Paths can be absolute, or relative to the backend/ folder.

# REQUIRED: the trained pipeline saved from your Kaggle notebook.
#   MODEL_PATH=../saved models/improved_lr_pipeline.joblib
MODEL_PATH=

# REQUIRED for improved_lr_pipeline.joblib: the clean_text() function the pipeline was trained with.
#   CLEAN_TEXT_PATH=../saved models/clean_text.py
CLEAN_TEXT_PATH=

# Decision threshold and minimum word count saved with the model ({"ai_threshold": ..., "min_words": ...}).
# If left empty, the label is whichever probability is higher and the minimum is 3 words.
#   MODEL_CONFIG_PATH=../saved models/improved_model_config.json
MODEL_CONFIG_PATH=

# Class value the model uses for AI-generated text (dataset column `generated`: 1 = AI, 0 = human).
AI_CLASS_LABEL=1

# Comma-separated list of frontend origins allowed by CORS (Vite dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum input length in characters.
MAX_TEXT_CHARS=50000
